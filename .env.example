# Disposable local development defaults. Use a fresh project for smoke tests.
POSTGRES_DB=oem
POSTGRES_USER=oem
POSTGRES_PASSWORD=change-me-local-only
S3_ACCESS_KEY_ID=oem-local
S3_SECRET_ACCESS_KEY=change-me-storage-local-only
S3_BUCKET=oem-artifacts
OEM_API_PORT=8000
OEM_UI_PORT=5173

# Set to oem-test-agent-01 to enable the read-only C2 manifest probe.
MINIFI_PROBE_AGENT_ID=
