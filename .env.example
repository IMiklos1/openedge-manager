# Disposable local development defaults. Use a fresh project for smoke tests.
POSTGRES_DB=oem
POSTGRES_USER=oem
POSTGRES_PASSWORD=change-me-local-only
S3_ACCESS_KEY_ID=oem-local
S3_SECRET_ACCESS_KEY=change-me-storage-local-only
S3_BUCKET=oem-artifacts
OEM_API_PORT=8000
OEM_UI_PORT=5173

# Set to oem-test-agent-01 to enable the read-only C2 manifest probe.
MINIFI_PROBE_AGENT_ID=

# Explicit IDs replace the built-in Compose test targets.
MINIFI_FLOW_AGENT_ID=
MINIFI_FLOW_AGENT_IDS=
# Set false to disable the built-in targets without configuring replacements.
# MINIFI_ENABLE_COMPOSE_TEST_TARGETS=false

# Require a separate opt-in before deploying flows that execute system commands.
MINIFI_ALLOW_EXECUTION_PROCESSORS=false
